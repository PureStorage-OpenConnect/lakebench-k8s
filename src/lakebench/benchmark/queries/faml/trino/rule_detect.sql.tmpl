-- Q_{rule_id}_detect: alerts per day for one rule.
-- Signal: silver enrichment throughput + gold materialization latency.
-- Placeholders: {catalog}, {rule_id}.
-- The 30-day window is anchored on the corpus's own data clock (the latest
-- alert), not the wall clock: the synthetic corpus ends before today, so a
-- CURRENT_TIMESTAMP window scanned nothing and the query timed as trivially
-- fast, inflating QpH.
SELECT
  DATE_TRUNC('day', alert_ts) AS alert_day,
  rule_id,
  priority,
  COUNT(*) AS alerts
FROM {catalog}.gold.alerts
WHERE rule_id = '{rule_id}'
  AND alert_ts BETWEEN (SELECT MAX(alert_ts) FROM {catalog}.gold.alerts) - INTERVAL '30' DAY
                   AND (SELECT MAX(alert_ts) FROM {catalog}.gold.alerts)
GROUP BY 1, 2, 3
ORDER BY 1;

-- Q_{rule_id}_precision: fraction of alerts that landed on a planted
-- {typology_type} typology row. Precision = TP / (TP + FP).
-- Placeholders: {catalog}, {rule_id}, {typology_type}.
-- Equi-join on unnested uetrs (see rule_recall); alerts scoped to the run
-- in gold.detection_status.
WITH run AS (
  SELECT MAX(run_id) AS run_id FROM {catalog}.gold.detection_status
),
rule_alerts AS (
  SELECT a.alert_id, a.alert_ts, a.related_txn_ids
  FROM {catalog}.gold.alerts a
  JOIN run ON a.run_id = run.run_id
  WHERE a.rule_id = '{rule_id}'
),
alert_uetrs AS (
  SELECT ra.alert_id, ra.alert_ts, t.uetr
  FROM rule_alerts ra
  CROSS JOIN UNNEST(ra.related_txn_ids) AS t(uetr)
),
typ_uetrs AS (
  SELECT u.uetr, m.injection_ts_start, m.injection_ts_end
  FROM {catalog}.bronze.manifest m
  CROSS JOIN UNNEST(m.participant_uetrs) AS u(uetr)
  WHERE m.typology_type = '{typology_type}'
),
matched AS (
  SELECT DISTINCT au.alert_id
  FROM alert_uetrs au
  JOIN typ_uetrs tu ON tu.uetr = au.uetr
  WHERE au.alert_ts BETWEEN tu.injection_ts_start
                        AND tu.injection_ts_end + INTERVAL '7' DAY
)
SELECT
  ROUND(100.0 * COUNT(m.alert_id) / NULLIF(COUNT(ra.alert_id), 0), 2) AS precision_pct,
  COUNT(ra.alert_id) AS total_alerts,
  COUNT(m.alert_id) AS true_positives
FROM rule_alerts ra
LEFT JOIN matched m USING (alert_id);

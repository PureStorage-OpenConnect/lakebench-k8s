-- Q_{rule_id}_recall: fraction of planted {typology_type} instances
-- that generated at least one {rule_id} alert. Recall = TP / (TP + FN).
-- Placeholders: {catalog}, {rule_id}, {typology_type}.
--
-- Both sides are unnested to (id, uetr) and equi-joined: ARRAYS_OVERLAP is
-- not an equi-join, so the old form was a nested loop over manifest x
-- alerts that did not finish at scale 10. Alerts are scoped to the run
-- recorded in gold.detection_status, so a reused catalog cannot mix runs.
WITH run AS (
  SELECT MAX(run_id) AS run_id FROM {catalog}.gold.detection_status
),
typ_uetrs AS (
  SELECT m.typology_id, u.uetr, m.injection_ts_start, m.injection_ts_end
  FROM {catalog}.bronze.manifest m
  CROSS JOIN UNNEST(m.participant_uetrs) AS u(uetr)
  WHERE m.typology_type = '{typology_type}'
),
alert_uetrs AS (
  SELECT a.alert_ts, t.uetr
  FROM {catalog}.gold.alerts a
  CROSS JOIN UNNEST(a.related_txn_ids) AS t(uetr)
  JOIN run ON a.run_id = run.run_id
  WHERE a.rule_id = '{rule_id}'
),
detected AS (
  SELECT DISTINCT tu.typology_id
  FROM typ_uetrs tu
  JOIN alert_uetrs au ON au.uetr = tu.uetr
  WHERE au.alert_ts BETWEEN tu.injection_ts_start
                        AND tu.injection_ts_end + INTERVAL '7' DAY
),
instances AS (
  SELECT DISTINCT typology_id
  FROM {catalog}.bronze.manifest
  WHERE typology_type = '{typology_type}'
)
SELECT
  ROUND(100.0 * COUNT(d.typology_id) / NULLIF(COUNT(i.typology_id), 0), 2) AS recall_pct,
  COUNT(i.typology_id) AS total_typologies,
  COUNT(d.typology_id) AS detected
FROM instances i
LEFT JOIN detected d ON d.typology_id = i.typology_id;

-- Per-rule false positives and txn precision, over the FULL manifest (an
-- alert on a planted txn not yet covered is no false positive). Integer
-- counts only. Reads gold.alerts and bronze.manifest only.
-- Placeholders: {catalog}, {run_id}, {alerts_pin}, {manifest_pin},
-- {targets_values} (VALUES of (rule_id, target_typology) for designated
-- rules, or "" when none).
-- Mirrors compute_scores FP half:
--  * one row per distinct (alert_id, rule_id, uetr) with on_target =
--    does the uetr belong to the alert rule's target typology;
--  * per_alert hit = any on-target uetr; fp_by_rule = alerts with no hit;
--    txn_precision = on-target pairs / all pairs;
--  * a rule with no target is left out (no FP meaning).
-- Memory shape: the alerts' payment lists are never exploded into a DISTINCT
-- or a GROUP BY at (alert, uetr) grain (hundreds of millions of rows at
-- scale 20 after an hour). Per-alert pair counts come from the arrays; the
-- exploded alerts are the probe side of one inner join to the manifest
-- (small, the build side), so only on-target pairs reach an aggregation.
-- alert_id is a uuid, one row per alert.
WITH targets AS (
  {targets_values}
),
-- manifest uetr -> its typology_type (distinct, non-null uetr).
manifest_uetr AS (
  SELECT DISTINCT u.uetr, m.typology_type
  FROM {catalog}.bronze.manifest {manifest_pin} m
  CROSS JOIN UNNEST(m.participant_uetrs) AS u(uetr)
  WHERE u.uetr IS NOT NULL
),
-- Alerts of designated rules with at least one related payment (an alert
-- with none has no pair and is not counted, as the exploded form had it).
alerts AS (
  SELECT a.alert_id, a.rule_id, t.target, ARRAY_DISTINCT(a.related_txn_ids) AS uetrs
  FROM {catalog}.gold.alerts {alerts_pin} a
  JOIN targets t ON t.rule_id = a.rule_id
  WHERE a.run_id = '{run_id}'
    AND CARDINALITY(a.related_txn_ids) > 0
),
-- On-target distinct pairs per alert: manifest_uetr is distinct on
-- (uetr, typology_type) and the target is one type, so each matching uetr
-- joins once. An alert with a row here is a hit.
hits AS (
  SELECT al.alert_id, al.rule_id, COUNT(*) AS on_pairs
  FROM alerts al
  CROSS JOIN UNNEST(al.uetrs) AS u(uetr)
  JOIN manifest_uetr mu ON mu.uetr = u.uetr AND mu.typology_type = al.target
  GROUP BY al.alert_id, al.rule_id
),
per_rule AS (
  SELECT rule_id, COUNT(*) AS rule_alerts, SUM(CARDINALITY(uetrs)) AS txn_pairs
  FROM alerts
  GROUP BY rule_id
),
hit_rule AS (
  SELECT rule_id, COUNT(*) AS hit_alerts, SUM(on_pairs) AS on_pairs
  FROM hits
  GROUP BY rule_id
)
SELECT pr.rule_id,
       pr.rule_alerts,
       pr.rule_alerts - COALESCE(hr.hit_alerts, 0) AS off_alerts,
       COALESCE(hr.on_pairs, 0) AS on_target_txn_pairs,
       pr.txn_pairs
FROM per_rule pr
LEFT JOIN hit_rule hr ON hr.rule_id = pr.rule_id
ORDER BY pr.rule_id;

-- Per-reason-code counts for the designated rules that ran (_scores_by_code).
-- Integer counts only; the assembler builds recall_by_code / fp_by_code /
-- alerts_by_code from them and the REASON_CODES vocabulary.
-- Returns one row per (rule_id, code):
--   n_by        = distinct alerts of the rule carrying the code
--   n_with_txn  = those with >=1 related payment (fp denominator)
--   hit_inst    = distinct target-typology instances the rule's code-alerts hit
--   hit_alerts  = distinct code-alerts that are on target
-- Placeholders: {catalog}, {run_id}, {alerts_pin}, {manifest_pin},
-- {targets_values} (VALUES of (rule_id, target_typology) for the designated
-- rules that ran). The assembler also needs the uncoded-alert count, from
-- by_code_meta.sql.tmpl, and the per-typology instance counts, from
-- coverage_recall.sql.tmpl.
-- Memory shape: the alerts' payment lists are exploded once, as the probe
-- side of the join to the manifest (build side); only on-target matches are
-- fanned out over the codes and made distinct.
WITH ran_targets AS (
  {targets_values}
),
alerts AS (
  SELECT a.alert_id, a.rule_id, rt.target, a.reason_codes, a.related_txn_ids
  FROM {catalog}.gold.alerts {alerts_pin} a
  JOIN ran_targets rt ON rt.rule_id = a.rule_id
  WHERE a.run_id = '{run_id}'
),
-- with_txn: the alert has at least one related payment (an exploded form
-- would give it at least one row).
codes AS (
  SELECT DISTINCT al.alert_id, al.rule_id, c.code,
         CARDINALITY(al.related_txn_ids) > 0 AS with_txn
  FROM alerts al
  CROSS JOIN UNNEST(al.reason_codes) AS c(code)
),
manifest_uetr AS (
  SELECT DISTINCT u.uetr, m.typology_type, m.typology_id
  FROM {catalog}.bronze.manifest {manifest_pin} m
  CROSS JOIN UNNEST(m.participant_uetrs) AS u(uetr)
  WHERE u.uetr IS NOT NULL
),
-- (rule, code, alert, target instance) for every on-target payment of an
-- alert, in one pass: the exploded alerts probe the manifest (build side),
-- and only the matches are fanned out over the alert's codes.
on_target AS (
  SELECT DISTINCT al.rule_id, c.code, al.alert_id, mu.typology_id
  FROM alerts al
  CROSS JOIN UNNEST(al.related_txn_ids) AS u(uetr)
  JOIN manifest_uetr mu ON mu.uetr = u.uetr AND mu.typology_type = al.target
  CROSS JOIN UNNEST(al.reason_codes) AS c(code)
),
code_alerts AS (
  SELECT rule_id, code,
         COUNT(DISTINCT alert_id) AS n_by,
         COUNT(DISTINCT CASE WHEN with_txn THEN alert_id END) AS n_with_txn
  FROM codes
  GROUP BY rule_id, code
),
code_hits AS (
  SELECT rule_id, code,
         COUNT(DISTINCT typology_id) AS hit_inst,
         COUNT(DISTINCT alert_id) AS hit_alerts
  FROM on_target
  GROUP BY rule_id, code
)
SELECT ca.rule_id, ca.code,
       ca.n_by,
       ca.n_with_txn,
       COALESCE(ch.hit_inst, 0) AS hit_inst,
       COALESCE(ch.hit_alerts, 0) AS hit_alerts
FROM code_alerts ca
LEFT JOIN code_hits ch ON ch.rule_id = ca.rule_id AND ch.code = ca.code
ORDER BY ca.rule_id, ca.code;

---
# DuckDB Query Engine Deployment
# Single-pod deployment using sleep infinity pattern.
# Queries are executed via kubectl exec into the DuckDB CLI.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: lakebench-duckdb
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: duckdb
    app.kubernetes.io/managed-by: lakebench
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: lakebench
      app.kubernetes.io/component: duckdb
  template:
    metadata:
      labels:
        app.kubernetes.io/name: lakebench
        app.kubernetes.io/component: duckdb
    spec:
      containers:
        - name: duckdb
          image: {{ duckdb_image }}
          imagePullPolicy: {{ image_pull_policy }}
          command:
            - "sh"
            - "-c"
            - |
              pip install --no-cache-dir --quiet duckdb=={{ duckdb_version | default('1.5.5') }} &&
              python -c "import duckdb; c=duckdb.connect(); c.execute('INSTALL iceberg'); c.execute('INSTALL httpfs'); print('DuckDB extensions installed')" &&
              sleep infinity
          env:
            - name: HOME
              value: /tmp
            - name: AWS_REGION
              value: "{{ s3_region }}"
            - name: AWS_DEFAULT_REGION
              value: "{{ s3_region }}"
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: lakebench-s3-credentials
                  key: accessKey
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: lakebench-s3-credentials
                  key: secretKey
            - name: S3_ENDPOINT
              value: "{{ s3_endpoint }}"
            - name: S3_PATH_STYLE
              value: "{{ s3_path_style | lower }}"
          resources:
            requests:
              cpu: "{{ duckdb_cores }}"
              memory: "{{ duckdb_memory_k8s }}"
            limits:
              cpu: "{{ duckdb_cores }}"
              memory: "{{ duckdb_memory_k8s }}"
          startupProbe:
            exec:
              command: ["python", "-c", "import duckdb; c=duckdb.connect(); c.load_extension('iceberg'); c.load_extension('httpfs'); print('ok')"]
            initialDelaySeconds: 10
            periodSeconds: 10
            # The command starts python, imports duckdb and loads two
            # extensions: 1.38 s measured in a running pod (2026-09-27). The
            # 1 s default failed it at random, restarting the container twice
            # and stretching one deploy to 892 s.
            timeoutSeconds: 15
            failureThreshold: 30
          readinessProbe:
            exec:
              command: ["python", "-c", "import duckdb; print('ok')"]
            initialDelaySeconds: 5
            periodSeconds: 30
            timeoutSeconds: 10
          livenessProbe:
            exec:
              command: ["python", "-c", "import duckdb; print('ok')"]
            initialDelaySeconds: 5
            periodSeconds: 60
            # A python start plus import under the CPU limit can pass 1 s too;
            # a liveness failure restarts the engine mid-benchmark.
            timeoutSeconds: 10

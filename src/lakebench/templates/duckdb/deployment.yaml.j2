---
# DuckDB Query Engine Deployment
# Single-pod deployment using sleep infinity pattern.
# Queries are executed via kubectl exec into the DuckDB CLI.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: lakebench-duckdb
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: duckdb
    app.kubernetes.io/managed-by: lakebench
spec:
  replicas: 1
  # One pod at a time, so no query runs on a pod with the old set.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: lakebench
      app.kubernetes.io/component: duckdb
  template:
    metadata:
      labels:
        app.kubernetes.io/name: lakebench
        app.kubernetes.io/component: duckdb
      annotations:
        lakebench.io/deps-set: "{{ deps_pinset }}"
    spec:
      # The DuckDB wheel and its extensions come from the deployment's
      # dependency set, each file checked against the lb-deps-manifest
      # ConfigMap; nothing is installed from PyPI or extensions.duckdb.org.
      initContainers:
        - name: lb-deps-fetch
          image: {{ duckdb_image }}
          imagePullPolicy: {{ image_pull_policy }}
          command:
            - "sh"
            - "-c"
            - |
              set -e
              python3 {{ deps_tools_mount }}/lb_deps.py fetch --group duckdb-ext --dest /tmp/.duckdb/extensions --manifest {{ deps_manifest_mount }}/manifest.json --url {{ deps_base_url }}
              python3 -m pip install --no-index --no-deps --no-cache-dir --only-binary=:all: --trusted-host {{ deps_host }} --find-links {{ deps_base_url }}/duckdb/wheels/ --require-hashes -r {{ deps_manifest_mount }}/requirements-duckdb.txt --target /opt/lb-deps/py
          env:
            - name: HOME
              value: /tmp
          volumeMounts:
            - name: lb-deps-py
              mountPath: /opt/lb-deps/py
            - name: duckdb-ext
              mountPath: /tmp/.duckdb/extensions
            - name: lb-deps-tools
              mountPath: {{ deps_tools_mount }}
              readOnly: true
            - name: lb-deps-manifest
              mountPath: {{ deps_manifest_mount }}
              readOnly: true
      volumes:
        - name: lb-deps-py
          emptyDir: {}
        - name: duckdb-ext
          emptyDir: {}
        - name: lb-deps-tools
          configMap:
            name: {{ deps_tools_configmap }}
        - name: lb-deps-manifest
          configMap:
            name: {{ deps_manifest_configmap }}
      containers:
        - name: duckdb
          image: {{ duckdb_image }}
          imagePullPolicy: {{ image_pull_policy }}
          command: ["sleep", "infinity"]
          env:
            - name: HOME
              value: /tmp
            - name: PYTHONPATH
              value: /opt/lb-deps/py
            - name: AWS_REGION
              value: "{{ s3_region }}"
            - name: AWS_DEFAULT_REGION
              value: "{{ s3_region }}"
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: lakebench-s3-credentials
                  key: accessKey
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: lakebench-s3-credentials
                  key: secretKey
            - name: S3_ENDPOINT
              value: "{{ s3_endpoint }}"
            - name: S3_PATH_STYLE
              value: "{{ s3_path_style | lower }}"
          resources:
            requests:
              cpu: "{{ duckdb_cores }}"
              memory: "{{ duckdb_memory_k8s }}"
            limits:
              cpu: "{{ duckdb_cores }}"
              memory: "{{ duckdb_memory_k8s }}"
          volumeMounts:
            - name: lb-deps-py
              mountPath: /opt/lb-deps/py
              readOnly: true
            - name: duckdb-ext
              mountPath: /tmp/.duckdb/extensions
          startupProbe:
            exec:
              command: ["python", "-c", "import duckdb; c=duckdb.connect(); c.execute('SET autoinstall_known_extensions=false'); c.load_extension('iceberg'); c.load_extension('httpfs'); print('ok')"]
            initialDelaySeconds: 10
            periodSeconds: 10
            # The command starts python, imports duckdb and loads two
            # extensions: 1.38 s measured in a running pod (2026-09-27). The
            # 1 s default failed it at random, restarting the container twice
            # and stretching one deploy to 892 s.
            timeoutSeconds: 15
            failureThreshold: 30
          readinessProbe:
            exec:
              command: ["python", "-c", "import duckdb; print('ok')"]
            initialDelaySeconds: 5
            periodSeconds: 30
            timeoutSeconds: 10
          livenessProbe:
            exec:
              command: ["python", "-c", "import duckdb; print('ok')"]
            initialDelaySeconds: 5
            periodSeconds: 60
            # A python start plus import under the CPU limit can pass 1 s too;
            # a liveness failure restarts the engine mid-benchmark.
            timeoutSeconds: 10

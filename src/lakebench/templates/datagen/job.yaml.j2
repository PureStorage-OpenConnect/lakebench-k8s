---
# Lakebench Data Generation Job
# Uses Kubernetes Indexed Job for parallel data generation
apiVersion: batch/v1
kind: Job
metadata:
  name: lakebench-datagen
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/instance: {{ name }}
    app.kubernetes.io/component: datagen
    app.kubernetes.io/managed-by: lakebench
spec:
  parallelism: {{ datagen_parallelism }}
  completions: {{ datagen_parallelism }}
  completionMode: Indexed
  backoffLimit: 60
  ttlSecondsAfterFinished: {{ datagen_ttl_seconds }}
  template:
    metadata:
      labels:
        app: lakebench-datagen
        app.kubernetes.io/name: lakebench
        app.kubernetes.io/instance: {{ name }}
        app.kubernetes.io/component: datagen
    spec:
      serviceAccountName: lakebench-spark-runner
      restartPolicy: OnFailure
      {% set heldout = datagen_schema == 'financial' %}
      {% if s3_ca_cert_pem or heldout %}
      volumes:
        {% if s3_ca_cert_pem %}
        - name: ca-cert
          secret:
            secretName: lakebench-ca-certificate
        {% endif %}
        {% if heldout %}
        {# The held-out hash file; the generator refuses the financial schema
           without it. #}
        - name: heldout
          configMap:
            name: {{ datagen_heldout_map }}
            optional: false
        {% endif %}
      {% endif %}
      containers:
        - name: datagen
          image: {{ datagen_image }}
          imagePullPolicy: {{ image_pull_policy }}
          args:
            - "--schema"
            - "{{ datagen_schema }}"
            {# --scale drives the financial corpus (typology counts, world
               size); --customer-id-max drives the c360 customer id space.
               Each schema gets only its own: on c360, --scale would be
               ignored and `scale` dropped from provenance. #}
            {% if datagen_schema == 'financial' %}
            - "--scale"
            - "{{ datagen_scale_factor }}"
            {% endif %}
            - "--target-tb"
            - "{{ datagen_target_tb }}"
            {% if datagen_schema == 'customer360' %}
            - "--customer-id-max"
            - "{{ datagen_customer_id_max }}"
            {% endif %}
            - "--mode"
            - "all"
            {# The datagen mode sets the delivery pattern (batch, or a
               continuous stream through S3 multipart), not the work split,
               which stays `all`. #}
            - "--delivery-mode"
            - "{{ datagen_mode }}"
            - "--file-size-mb"
            - "{{ datagen_file_size_mb }}"
            - "--bucket"
            - "{{ bucket_bronze }}"
            - "--prefix"
            - "{{ datagen_path_prefix }}"
            {# A registered (held-out) corpus's seed comes from the Secret
               through LB_DATAGEN_SEED below, never from the Job's args. #}
            {% if not datagen_seed_secret %}
            - "--seed"
            - "{{ datagen_seed }}"
            {% endif %}
            {% if datagen_robustness_perturbation %}
            - "--robustness-perturbation"
            {% endif %}
            - "--dirty-ratio"
            - "{{ datagen_dirty_ratio }}"
            - "--total-nodes"
            - "{{ datagen_parallelism }}"
            - "--workers"
            - "{{ datagen_workers }}"
            {% if datagen_timestamp_start %}
            - "--timestamp-start"
            - "{{ datagen_timestamp_start }}"
            {% endif %}
            {% if datagen_timestamp_end %}
            - "--timestamp-end"
            - "{{ datagen_timestamp_end }}"
            {% endif %}
            {% if datagen_deliver_until is defined %}
            - "--deliver-until"
            - "{{ datagen_deliver_until }}"
            {% endif %}
            {% if datagen_corpus_months is defined and datagen_corpus_months %}
            - "--corpus-months"
            - "{{ datagen_corpus_months }}"
            {% endif %}
            {% if datagen_cycles is defined and datagen_cycles > 1 %}
            - "--cycle"
            - "{{ datagen_cycle }}"
            - "--cycles"
            - "{{ datagen_cycles }}"
            {% endif %}
          env:
            # Kubernetes sets JOB_COMPLETION_INDEX (0, 1, 2, ...); the generator
            # uses it as its default node id.
            - name: S3_ENDPOINT
              value: "{{ s3_endpoint }}"
            - name: S3_REGION
              value: "{{ s3_region }}"
            # The Rust S3 sink reads AWS_REGION (object_store); without it,
            # PUTs are signed for us-east-1, which region-strict backends
            # (Garage, AWS) reject. Same class as fs.s3a.endpoint.region on the Spark side.
            - name: AWS_REGION
              value: "{{ s3_region }}"
            - name: S3_PATH_STYLE
              value: "{{ 'true' if s3_path_style else 'false' }}"
            - name: AWS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: lakebench-s3-credentials
                  key: accessKey
            - name: AWS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: lakebench-s3-credentials
                  key: secretKey
            {% if s3_ca_cert_pem %}
            - name: S3_CA_CERT
              value: "/etc/ssl/certs/custom-ca/ca.crt"
            # Also the trust store of rustls-native-certs, so an image that
            # predates S3_CA_CERT trusts the configured CA too. It replaces
            # the system store, which is why it is set only with a CA.
            - name: SSL_CERT_FILE
              value: "/etc/ssl/certs/custom-ca/ca.crt"
            {% elif not s3_verify_ssl %}
            - name: S3_VERIFY_SSL
              value: "false"
            {% endif %}
            {% if datagen_seed_secret %}
            - name: LB_DATAGEN_SEED
              valueFrom:
                secretKeyRef:
                  name: {{ datagen_seed_secret }}
                  key: {{ datagen_seed_secret_key }}
                  optional: false
            {% endif %}
            {% if heldout %}
            - name: LB_HELDOUT_HASHES
              value: "{{ datagen_heldout_dir }}/heldout_hashes.json"
            {% endif %}
            - name: CPU_LIMIT
              value: "{{ datagen_threads }}"
            # k8s CPU request in millicores, read by the Rust datagen at
            # completion for accurate CPU-hour accounting. When set, the
            # aggregator prefers this over rayon's pool size (which may
            # differ from the pod's request because rayon's default reads
            # `available_parallelism()`, not the cgroup CPU quota).
            - name: LB_POD_CPU_REQUEST_MILLI
              valueFrom:
                resourceFieldRef:
                  containerName: datagen
                  resource: requests.cpu
                  divisor: "1m"
            {% if pushgateway_url is defined and pushgateway_url %}
            # Live observability (best-effort): the pod pushes metrics to the
            # per-deployment Pushgateway. Absent when observability is off, in
            # which case the binary no-ops.
            - name: LB_PUSHGATEWAY_URL
              value: "{{ pushgateway_url }}"
            - name: LB_RUN_ID
              value: "{{ run_id }}"
            {% endif %}
          {% if s3_ca_cert_pem or heldout %}
          volumeMounts:
            {% if s3_ca_cert_pem %}
            - name: ca-cert
              mountPath: /etc/ssl/certs/custom-ca
              readOnly: true
            {% endif %}
            {% if heldout %}
            - name: heldout
              mountPath: {{ datagen_heldout_dir }}
              readOnly: true
            {% endif %}
          {% endif %}
          resources:
            requests:
              cpu: "{{ datagen_cpu }}"
              memory: "{{ datagen_memory }}"
            limits:
              cpu: "{{ datagen_cpu }}"
              memory: "{{ datagen_memory }}"

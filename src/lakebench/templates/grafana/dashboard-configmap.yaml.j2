                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lakebench-polaris-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "polaris",
              "refId": "H"

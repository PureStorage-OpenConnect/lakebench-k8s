              "legendFormat": "dependency server",
              "refId": "K"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "bytes",
              "custom": {
                "stacking": {
                  "mode": "normal"

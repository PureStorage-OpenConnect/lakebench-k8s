              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lakebench-(prometheus|grafana|pushgateway)-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "observability",
              "refId": "J"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lb-deps-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "dependency server",
              "refId": "K"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "palette-classic"
              },
              "unit": "short",
              "custom": {
                "stacking": {
                  "mode": "normal"
                },
                "fillOpacity": 25
              }
            }
          },
          "description": "Containers only, each counted once. Spark drivers and executors are grouped by stage."
        },

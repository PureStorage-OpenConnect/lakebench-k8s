{# Grafana dashboard provisioned via file provider.                          #}
{# One ConfigMap per deployment, in the deployment namespace. The dashboard   #}
{# uid is fixed; namespaces no longer collide because each deployment runs    #}
{# its own Grafana. `run_id` picks between runs in this namespace. Resource   #}
{# panels come from cAdvisor and Trino from the JMX exporter, so they work    #}
{# for batch and continuous runs; datagen and stage panels read Pushgateway   #}
{# series, which batch stages push and continuous stages do not.              #}
apiVersion: v1
kind: ConfigMap
metadata:
  name: lakebench-grafana-dashboard
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: grafana-dashboard
    grafana_dashboard: "1"
data:
  lakebench-overview.json: |
    {
      "annotations": {
        "list": []
      },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 1,
      "links": [],
      "templating": {
        "list": [
          {
            "name": "datasource",
            "type": "datasource",
            "query": "prometheus",
            "hide": 2,
            "current": {
              "text": "Prometheus",
              "value": "lakebench-prometheus"
            },
            "refresh": 1
          },
          {
            "name": "run_id",
            "type": "query",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "query": "label_values(lakebench_stage_elapsed_seconds, run_id)",
            "refresh": 2,
            "includeAll": true,
            "multi": true,
            "current": {},
            "sort": 1
          }
        ]
      },
      "panels": [
        {
          "id": 1,
          "title": "Resources by component (cAdvisor, this namespace)",
          "type": "row",
          "collapsed": false,
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 0
          },
          "panels": []
        },
        {
          "id": 2,
          "title": "CPU by component (cores)",
          "type": "timeseries",
          "gridPos": {
            "h": 9,
            "w": 12,
            "x": 0,
            "y": 1
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lakebench-datagen-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "datagen",
              "refId": "A"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"(lakebench-bronze-ingest-driver|lb-bronze-ingest-.*-exec-.*)\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "bronze-ingest",
              "refId": "B"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"(lakebench-silver-stream-driver|lb-silver-stream-.*-exec-.*)\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "silver-stream",
              "refId": "C"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"(lakebench-gold-refresh-driver|lb-gold-refresh-.*-exec-.*)\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "gold-refresh",
              "refId": "D"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"(lakebench-(bronze-verify|silver-build|gold-finalize)-driver|lb-(bronze-verify|silver-build|gold-finalize)-.*-exec-.*)\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "batch spark (verify/build/finalize)",
              "refId": "E"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lakebench-trino-coordinator-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "trino coordinator",
              "refId": "F"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lakebench-trino-worker-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "trino workers",
              "refId": "G"

            {
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum(max by (pod, container) (rate(container_cpu_usage_seconds_total{pod=~\"lakebench-postgres-.*\",container!=\"\",container!=\"POD\"}[2m])))",
              "legendFormat": "postgres",

{# Per-deployment Grafana (ownership category 1).                              #}
{# Datasource and the Lakebench Overview dashboard are provisioned from        #}
{# ConfigMaps; no sidecar, no dashboard discovery across namespaces. The       #}
{# admin password is generated per deploy into the lakebench-grafana Secret.   #}
---
apiVersion: v1
kind: Secret
metadata:
  name: lakebench-grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: grafana
type: Opaque
stringData:
  admin-user: admin
  admin-password: {{ grafana_admin_password }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: lakebench-grafana-provisioning
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: grafana
data:
  datasource.yaml: |
    apiVersion: 1
    datasources:
      - name: Prometheus
        uid: lakebench-prometheus
        type: prometheus
        access: proxy
        url: http://lakebench-prometheus:9090
        isDefault: true
  dashboards.yaml: |
    apiVersion: 1
    providers:
      - name: lakebench
        folder: Lakebench
        type: file
        disableDeletion: false
        updateIntervalSeconds: 30
        options:
          path: /var/lib/grafana/dashboards
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: lakebench-grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: grafana
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: lakebench
      app.kubernetes.io/component: grafana
  template:
    metadata:
      labels:
        app.kubernetes.io/name: lakebench
        app.kubernetes.io/component: grafana
    spec:
      containers:
        - name: grafana
          image: {{ grafana_image }}
          env:
            - name: GF_SECURITY_ADMIN_USER
              valueFrom:
                secretKeyRef:
                  name: lakebench-grafana
                  key: admin-user
            - name: GF_SECURITY_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: lakebench-grafana
                  key: admin-password
            - name: GF_ANALYTICS_REPORTING_ENABLED
              value: "false"
            - name: GF_ANALYTICS_CHECK_FOR_UPDATES
              value: "false"
          ports:
            - name: http
              containerPort: 3000
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
          readinessProbe:
            httpGet: {path: /api/health, port: 3000}
            initialDelaySeconds: 10
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /var/lib/grafana
            - name: provisioning
              mountPath: /etc/grafana/provisioning/datasources/datasource.yaml
              subPath: datasource.yaml
            - name: provisioning
              mountPath: /etc/grafana/provisioning/dashboards/dashboards.yaml
              subPath: dashboards.yaml
            - name: dashboard
              mountPath: /var/lib/grafana/dashboards
      volumes:
        - name: data
          emptyDir: {}
        - name: provisioning
          configMap:
            name: lakebench-grafana-provisioning
        - name: dashboard
          configMap:
            name: lakebench-grafana-dashboard
---
apiVersion: v1
kind: Service
metadata:
  name: lakebench-grafana
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: grafana
spec:
  selector:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: grafana
  ports:
    - name: http
      port: 3000
      targetPort: 3000

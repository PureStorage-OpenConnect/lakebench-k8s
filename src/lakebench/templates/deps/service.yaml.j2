---
# The dependency server inside this deployment's namespace (DEP-2).
apiVersion: v1
kind: Service
metadata:
  name: {{ server_name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: deps
    app.kubernetes.io/managed-by: lakebench
    lakebench.io/deployment: "{{ deployment_name }}"
    lakebench.io/deps-role: server
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/component: deps
    lakebench.io/deps-role: server
  ports:
    - name: http
      port: {{ port }}
      targetPort: {{ port }}

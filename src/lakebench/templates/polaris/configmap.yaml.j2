---
# Polaris server configuration (application.properties)
# Mounted at /deployments/config/application.properties
# SmallRye Config picks this up automatically for Quarkus apps
apiVersion: v1
kind: ConfigMap
metadata:
  name: lakebench-polaris-config
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: lakebench
    app.kubernetes.io/instance: {{ name }}
    app.kubernetes.io/component: polaris
    app.kubernetes.io/managed-by: lakebench
data:
  application.properties: |
    # FlashBlade S3: stsUnavailable=true on each catalog handles STS skip.
    # No server-wide credential-subscoping override is added or supported;
    # any such override drops endpoint + pathStyleAccess from the
    # StorageAccessConfig and forces server-side S3FileIO to fall back to
    # s3.amazonaws.com (see BUG-P10).
    #
    # Server-side S3 credentials (for FileIO metadata validation).
    # These are used by the AwsCredentialsStorageIntegration when
    # stsUnavailable=true skips STS AssumeRole but the SDK still needs
    # credentials from the default credential chain (AWS_ACCESS_KEY_ID env var).
    polaris.storage.aws.access-key={{ s3_access_key }}
    polaris.storage.aws.secret-key={{ s3_secret_key }}
    # Allow per-namespace and per-table locations. The bootstrap creates the
    # silver and gold namespaces with a location in their own bucket and the
    # catalog allows all three bucket locations, but Polaris refuses a
    # namespace or table location outside the catalog's default base unless
    # these are enabled, so silver and gold tables inherited the bronze base
    # and all three zones landed in the bronze bucket. Enabling them lets the
    # per-zone namespace locations take effect, so each zone's data lands in
    # its own bucket.
    polaris.features."ALLOW_NAMESPACE_LOCATION_OVERRIDE"=true
    polaris.features."ALLOW_TABLE_LOCATION_OVERRIDE"=true
